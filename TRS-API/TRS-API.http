@TRS_API_HostAddress = http://localhost:5119
@ApiKey = xyz

GET {{TRS_API_HostAddress}}/health/
Accept: application/json

###

POST {{TRS_API_HostAddress}}/user/
X-API-KEY: {{ApiKey}}
Content-Type: application/json

{
  "firstName": "Anna",
  "lastName": "Svensson",
  "email": "anna@example.com"
}

###

POST {{TRS_API_HostAddress}}/user/login/
X-API-KEY: {{ApiKey}}
Content-Type: application/json

{
  "email": "anna@example.com"
}

###

POST {{TRS_API_HostAddress}}/user/login/verify/
X-API-KEY: {{ApiKey}}
Content-Type: application/json

{
  "email": "anna@example.com",
  "code": "123456"
}

###

# Paste the tokens from the verify response here
@AccessToken = 
@RefreshToken = 

POST {{TRS_API_HostAddress}}/user/refresh/
X-API-KEY: {{ApiKey}}
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

###

POST {{TRS_API_HostAddress}}/user/logout/
X-API-KEY: {{ApiKey}}
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

###

GET {{TRS_API_HostAddress}}/user/me/
X-API-KEY: {{ApiKey}}
Authorization: Bearer {{AccessToken}}

###

POST {{TRS_API_HostAddress}}/organization/
X-API-KEY: {{ApiKey}}
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "name": "Trailrunning Sweden"
}

###

GET {{TRS_API_HostAddress}}/organization/1/members/
X-API-KEY: {{ApiKey}}
Authorization: Bearer {{AccessToken}}

###

POST {{TRS_API_HostAddress}}/organization/1/members/
X-API-KEY: {{ApiKey}}
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "userId": 2,
  "memberType": "Member"
}

###

DELETE {{TRS_API_HostAddress}}/organization/1/members/2/
X-API-KEY: {{ApiKey}}
Authorization: Bearer {{AccessToken}}

###

POST {{TRS_API_HostAddress}}/organization/1/membership-requests/
X-API-KEY: {{ApiKey}}
Authorization: Bearer {{AccessToken}}

###

POST {{TRS_API_HostAddress}}/organization/1/members/2/approve/
X-API-KEY: {{ApiKey}}
Authorization: Bearer {{AccessToken}}

###
